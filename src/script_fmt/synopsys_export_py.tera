#!/usr/bin/env python3
# {{ HEADER_AUTOGEN }}

import os
import sys
import shutil
import argparse
import hashlib

def get_dir_hash(dir_path, outdir):
    hasher = hashlib.sha256()
    if not os.path.exists(dir_path):
        return hasher.hexdigest()
    
    abs_outdir = os.path.abspath(outdir)
    
    for root, dirs, files in os.walk(dir_path, topdown=True):
        dirs[:] = [d for d in dirs if d not in ('.git', '.bender', '__pycache__') and 
                   not os.path.abspath(os.path.join(root, d)).startswith(abs_outdir)]
        dirs.sort()
        for name in sorted(files):
            file_path = os.path.join(root, name)
            try:
                with open(file_path, "rb") as f:
                    rel_path = os.path.relpath(file_path, dir_path)
                    hasher.update(rel_path.encode('utf-8'))
                    hasher.update(f.read())
            except OSError:
                pass
    return hasher.hexdigest()

def get_file_hash(file_path):
    hasher = hashlib.sha256()
    if not os.path.exists(file_path):
        return hasher.hexdigest()
    try:
        with open(file_path, "rb") as f:
            hasher.update(f.read())
    except OSError:
        pass
    return hasher.hexdigest()

def main():
    parser = argparse.ArgumentParser(description="Export sources and generate Synopsys TCL script.")
    parser.add_argument("--outdir", default="export", help="Output directory for the exported files")
    args = parser.parse_args()

    outdir = args.outdir
    os.makedirs(outdir, exist_ok=True)

    tcl_script_path = os.path.join(outdir, "synopsys_export.tcl")

    # Python representation of bender data
    verilog_args = [{% for tmp_arg in verilog_args %}"{{ tmp_arg }}",{% endfor %}]
    vhdl_args = [{% for tmp_arg in vhdl_args %}"{{ tmp_arg }}",{% endfor %}]

    compilation_mode = "{{ compilation_mode }}"

{% if compilation_mode == 'separate' %}
    groups = [
{% for group in srcs %}{% if group.file_type != '' %}
        {
            "metadata": "{{ group.metadata }}",
            "file_type": "{{ group.file_type }}",
            "incdirs": [
{% for incdir in group.incdirs %}
                "{{ incdir }}",
{% endfor %}
            ],
            "defines": [
{% for define in group.defines %}
                ("{{ define.0 }}", "{% if define.1 %}{{ define.1 }}{% endif %}"),
{% endfor %}
            ],
            "files": [
{% for file in group.files %}
                ("{{ file.file }}", "{% if file.comment %}{{ file.comment }}{% endif %}"),
{% endfor %}
            ],
        },
{% endif %}{% endfor %}
    ]
{% else %}
    groups = []
    
    # Common compilation mode
    all_verilog = [
{% for file in all_verilog %}
        ("{{ file.file }}", "{% if file.comment %}{{ file.comment }}{% endif %}"),
{% endfor %}
    ]
    all_vhdl = [
{% for file in all_vhdl %}
        ("{{ file.file }}", "{% if file.comment %}{{ file.comment }}{% endif %}"),
{% endfor %}
    ]

    all_incdirs = [
{% for incdir in all_incdirs %}
        "{{ incdir }}",
{% endfor %}
    ]

    all_defines = [
{% for define in all_defines %}
        ("{{ define.0 }}", "{% if define.1 %}{{ define.1 }}{% endif %}"),
{% endfor %}
    ]

    if all_verilog:
        groups.append({
            "metadata": "Common Verilog",
            "file_type": "verilog",
            "incdirs": all_incdirs,
            "defines": all_defines,
            "files": all_verilog,
        })
    
    if all_vhdl:
        groups.append({
            "metadata": "Common VHDL",
            "file_type": "vhdl",
            "incdirs": [], # VHDL usually doesn't need includes in the same way, but keeping it empty matching synopsys.tcl behavior
            "defines": [], 
            "files": all_vhdl,
        })
{% endif %}

    file_map = {}
    incdir_map = {}

    with open(tcl_script_path, "w") as tcl:
        tcl.write("# {{ HEADER_AUTOGEN }}\n")
        tcl.write("set search_path_initial $search_path\n")

        for group in groups:
{% if source_annotations %}
            if group.get("metadata"):
                tcl.write(f"# {group['metadata']}\n")
{% endif %}
            tcl.write("set search_path $search_path_initial\n")

            for incdir in group["incdirs"]:
                if incdir not in incdir_map:
                    new_incdir_name = get_dir_hash(incdir, outdir)[:16]
                    new_incdir_path = os.path.join(outdir, new_incdir_name)
                    if os.path.exists(incdir):
                        shutil.copytree(incdir, new_incdir_path, ignore=shutil.ignore_patterns('.git', '.bender', '__pycache__'), dirs_exist_ok=True)
                    else:
                        print(f"Warning: include dir {incdir} does not exist", file=sys.stderr)
                        os.makedirs(new_incdir_path, exist_ok=True)
                    incdir_map[incdir] = new_incdir_name

                tcl.write(f"lappend search_path [file join [file dirname [info script]] {incdir_map[incdir]}]\n")

{% if abort_on_error %}
            tcl.write("if {0 == [")
{% endif %}
            
            if group["file_type"] == "verilog":
                tcl.write("analyze -format sv ")
                for arg in verilog_args:
                    tcl.write(f"{arg} ")
            elif group["file_type"] == "vhdl":
                tcl.write("analyze -format vhdl ")
                for arg in vhdl_args:
                    tcl.write(f"{arg} ")

{% raw %}
            for k, v in group["defines"]:
                if v:
                    tcl.write(f"-define {{{k}={v}}} ")
                else:
                    tcl.write(f"-define {{{k}}} ")
{% endraw %}

            tcl.write("[list \\\n")

            for file_path, comment in group["files"]:
{% if source_annotations %}
                if comment:
                    tcl.write(f"    # {comment}\n")
{% endif %}
                if file_path not in file_map:
                    new_file_dir_name = get_file_hash(file_path)[:16]
                    new_file_dir_path = os.path.join(outdir, new_file_dir_name)
                    os.makedirs(new_file_dir_path, exist_ok=True)
                    basename = os.path.basename(file_path)
                    new_file_path = os.path.join(new_file_dir_path, basename)
                    if os.path.exists(file_path):
                        shutil.copy2(file_path, new_file_path)
                    else:
                        print(f"Warning: file {file_path} does not exist", file=sys.stderr)
                        # create an empty file just in case
                        open(new_file_path, "w").close()
                    file_map[file_path] = os.path.join(new_file_dir_name, basename)

                tcl.write(f"    [file join [file dirname [info script]] {file_map[file_path]}] \\\n")

{% if abort_on_error %}
            tcl.write("]]} {return 1}\n")
{% else %}
            tcl.write("]\n")
{% endif %}

        if not groups:
            # If there's no files at all, still valid
            pass

        tcl.write("set search_path $search_path_initial\n")

if __name__ == "__main__":
    main()
